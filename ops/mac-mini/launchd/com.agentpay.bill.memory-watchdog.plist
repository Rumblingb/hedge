<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentpay.bill.memory-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/brain/hedge/scripts/memory-watchdog.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/brain/hedge</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/brain/hedge/.rumbling-hedge/logs/memory-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/brain/hedge/.rumbling-hedge/logs/memory-watchdog.err.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
