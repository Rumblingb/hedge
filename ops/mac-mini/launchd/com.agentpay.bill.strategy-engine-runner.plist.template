<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentpay.bill.strategy-engine-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BILL_ROOT__/ops/mac-mini/bin/bill-strategy-engine-runner</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__BILL_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>BILL_ENABLE_FUTURES_DEMO_EXECUTION</key>
        <string>false</string>
        <key>RH_TOPSTEP_READ_ONLY</key>
        <string>true</string>
        <key>RH_LIVE_EXECUTION_ENABLED</key>
        <string>false</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__BILL_ROOT__/.rumbling-hedge/logs/strategy-engine-runner-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__BILL_ROOT__/.rumbling-hedge/logs/strategy-engine-runner-stderr.log</string>
</dict>
</plist>
