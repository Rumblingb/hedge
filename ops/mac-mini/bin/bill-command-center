#!/bin/bash
set -euo pipefail
source "$(dirname -- "$0")/_bill-common.sh"
root="$(bill_repo_root)"
load_bill_env
# Command Center is observability only. Force trading locks after bill.env so
# launchd restarts cannot inherit stale demo/live execution flags.
export BILL_ENABLE_FUTURES_DEMO_EXECUTION=false
export RH_TOPSTEP_READ_ONLY=true
export RH_LIVE_EXECUTION_ENABLED=false
ensure_bill_runtime_dirs
cd "$root"
exec python3 command_center_server.py
